# =====================================================================
# Video Factory — Production Environment Configuration Example
# Copy this file to .env and adjust values according to your environment
#
# NOTE: In NODE_ENV=production the runtime validates configuration and
# FAILS CLOSED — missing variables, placeholder values, and localhost
# endpoints are rejected instead of silently falling back to dev defaults.
# =====================================================================

# 1. PostgreSQL Database Configuration (required in production)
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/video_factory

# 2. Security & Token Encryption (AES-256-GCM) — REQUIRED in production
# 32+ character secret used to encrypt/decrypt OAuth access and refresh tokens
SOCIAL_TOKEN_ENCRYPTION_KEY=your_social_token_encryption_key_32_bytes_min

# Session cookie signing secret — REQUIRED in production.
# Signs vf_session_user_id so clients cannot forge identities.
VIDEO_FACTORY_SESSION_SECRET=replace_with_real_random_secret_32_bytes_min

# Optional dedicated OAuth state signing secret. Falls back to
# VIDEO_FACTORY_SESSION_SECRET then SOCIAL_TOKEN_ENCRYPTION_KEY.
# OAUTH_STATE_SECRET=replace_with_real_random_secret

# 3. n8n Orchestrator Integration (must not be localhost in production)
N8N_VIDEO_FACTORY_WEBHOOK_URL=https://n8n.example.com/webhook/vf-job-orchestrator
N8N_VIDEO_FACTORY_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# 4. Callback Security
# Shared secret verified by Video Factory when receiving n8n callbacks at POST /api/internal/n8n/events
VIDEO_FACTORY_N8N_CALLBACK_SECRET=your_callback_shared_secret_here

# 5. AI Providers Configuration
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Provider selection (mock/test values are rejected in production)
# IMAGE_PROVIDER=gemini|openai|mock
# VIDEO_PROVIDER=google|mock
# VOICE_PROVIDER=elevenlabs|mock
# STORAGE_PROVIDER=r2|mock
# Explicit dev-only escape hatch for publishing/analytics mocks:
# VIDEO_FACTORY_USE_MOCK_PROVIDERS=true   # NEVER set this in production

# 6. Cloudflare R2 Object Storage (required in production)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=video-factory-media
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
# Optional explicit endpoint override (defaults to https://<account>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL / R2_PUBLIC_DOMAIN for public media URLs if configured
R2_PUBLIC_DOMAIN=https://media.example.com

# 7. Social Platform OAuth & Publishing Integration
# YouTube (Google OAuth 2.0 Client)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Instagram Professional / Meta Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v22.0

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# 8. Launch Scope & Feature Flags
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true

# 9. Remotion Render Engine (real @remotion/renderer pipeline)
# Pre-bundled composition dir/URL — the Docker image ships /app/render-bundle.
# If unset, the engine bundles src/remotion-entry.tsx on demand (slower).
# REMOTION_SERVE_URL=
# REMOTION_ENTRY_POINT=
# REMOTION_PUBLIC_DIR=
# Browser binary: leave unset to auto-download Chrome Headless Shell, or point
# at a system Chrome/Chromium (Docker image sets /usr/bin/chromium).
# REMOTION_BROWSER_EXECUTABLE=
# REMOTION_CHROME_MODE=chrome-for-testing   # use with a real Chrome binary
# REMOTION_FRAME_TIMEOUT_MS=                # per-frame render timeout override

# 10. Web Application Settings (must be the real external origin in production)
NEXT_PUBLIC_APP_URL=https://app.example.com
NODE_ENV=development
