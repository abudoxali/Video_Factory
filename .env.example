# =====================================================================
# Video Factory — Production Environment Configuration Example
# Copy this file to .env and adjust values according to your environment
# =====================================================================

# 1. PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/video_factory

# 2. Security & Token Encryption (AES-256-GCM)
# 32-character secret string used to encrypt/decrypt OAuth access and refresh tokens
SOCIAL_TOKEN_ENCRYPTION_KEY=video_factory_prod_encryption_secret_key_32_bytes_min!

# 3. n8n Orchestrator Integration
# URL of the n8n webhook for VF-00 Core Job Orchestrator workflow
N8N_VIDEO_FACTORY_WEBHOOK_URL=http://localhost:5678/webhook/vf-job-orchestrator
N8N_VIDEO_FACTORY_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# 4. Callback Security
# Shared secret verified by Video Factory when receiving n8n callbacks at POST /api/internal/n8n/events
VIDEO_FACTORY_N8N_CALLBACK_SECRET=your_callback_shared_secret_here

# 5. AI Providers Configuration
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 6. Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=video-factory-media
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_DOMAIN=https://media.videofactory.app

# 7. Social Platform OAuth & Publishing Integration
# YouTube (Google OAuth 2.0 Client)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Instagram Professional / Meta Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v22.0

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# 8. Launch Scope & Feature Flags
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true

# 9. Web Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
