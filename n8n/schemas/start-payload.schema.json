{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "N8nStartPayload",
  "type": "object",
  "required": ["version", "job_id", "video_id", "request"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "job_id": {
      "type": "string",
      "description": "Unique job identifier prefixed with job_"
    },
    "video_id": {
      "type": "string",
      "description": "Unique video entity identifier prefixed with vid_"
    },
    "request": {
      "type": "object",
      "required": ["prompt", "type", "duration_seconds", "language", "platform", "aspect_ratio"],
      "properties": {
        "prompt": { "type": "string" },
        "type": { "type": "string", "enum": ["short", "long"] },
        "duration_seconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "language": { "type": "string", "enum": ["ar", "en"] },
        "platform": {
          "type": "string",
          "enum": ["tiktok", "instagram_reels", "youtube_shorts", "youtube", "linkedin", "x"]
        },
        "aspect_ratio": {
          "type": "string",
          "enum": ["9:16", "16:9", "1:1"]
        }
      }
    }
  }
}
