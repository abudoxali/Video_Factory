{
  "name": "VF-08 Asset Storage & Finalization",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-08-storage",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "id": "node-vf08-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nreturn {\n  json: {\n    job_id: body.job_id,\n    video_id: body.video_id,\n    assetsCount: body.assetsCount || 0,\n    storageProvider: 'r2'\n  }\n};"
      },
      "name": "Parse Storage Audit Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 240],
      "id": "node-vf08-parse"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_storage_done_\" + $json.job_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"storage.validated\",\n  \"status\": \"COMPLETED\",\n  \"stage\": \"MEDIA_READY\",\n  \"progress\": 100,\n  \"message\": \"تم التحقق من مطابقة وسلامة ملفات R2 وتجهيز بيئة المراجعة بالكامل\"\n}"
      },
      "name": "Notify Storage Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 240],
      "id": "node-vf08-notify"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Parse Storage Audit Request", "type": "main", "index": 0 }]
      ]
    },
    "Parse Storage Audit Request": {
      "main": [
        [{ "node": "Notify Storage Ready", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
