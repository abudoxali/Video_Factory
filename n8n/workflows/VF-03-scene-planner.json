{
  "name": "VF-03 Scene Planner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-03-scene-planner",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-vf03-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        240
      ],
      "webhookId": "vf-03-scene-planner"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst headers = $input.item.json.headers || {};\nconst secret = $env.N8N_VIDEO_FACTORY_WEBHOOK_SECRET;\nconst presented = body.webhook_secret || headers['x-webhook-secret'] || headers['X-Webhook-Secret'];\nif (!secret || presented !== secret) {\n  throw new Error('Unauthorized: invalid or missing webhook secret');\n}\nif (!body.video_id) throw new Error('video_id is required');\nreturn {\n  json: {\n    video_id: body.video_id || null,\n    job_id: body.job_id || '',\n    publication_id: body.publication_id || null,\n    render_id: body.render_id || null,\n    scene_id: body.scene_id || null,\n    platforms: body.platforms || null,\n    account_ids: body.account_ids || null,\n    metadata: body.metadata || null,\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "id": "node-vf03-validate",
      "name": "Validate & Authenticate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/planning/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"version\": \"1.0\",\n  \"video_id\": $json.video_id,\n  \"job_id\": $json.job_id,\n  \"stage\": \"SCENE_PLANNING\"\n}) }}",
        "options": {
          "timeout": 600000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node-vf03-execute",
      "name": "Execute Real Scene Planning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-vf03-outcome",
      "name": "Scenes Generated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_\" + $('Execute Real Scene Planning').item.json.job_id || $('Validate & Authenticate').item.json.job_id + \"_\" + Date.now(),\n  \"job_id\": $('Execute Real Scene Planning').item.json.job_id || $('Validate & Authenticate').item.json.job_id,\n  \"event\": \"planning.ready\",\n  \"status\": \"COMPLETED\",\n  \"stage\": \"PLAN_READY\",\n  \"progress\": 100,\n  \"message\": \"اكتمل تخطيط المشاهد الحقيقي — الخطة جاهزة للاعتماد\"\n}) }}",
        "options": {
          "timeout": 600000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node-vf03-ok",
      "name": "Callback: Plan Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_\" + $('Validate & Authenticate').item.json.job_id + \"_\" + Date.now(),\n  \"job_id\": $('Validate & Authenticate').item.json.job_id,\n  \"event\": \"planning.failed\",\n  \"status\": \"FAILED\",\n  \"stage\": \"ERROR\",\n  \"progress\": 50,\n  \"message\": \"فشل تخطيط المشاهد: '\" + ($json.error || 'provider failure') + \"'\"\n}) }}",
        "options": {
          "timeout": 600000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node-vf03-fail",
      "name": "Callback: Scenes Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        340
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate & Authenticate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Authenticate": {
      "main": [
        [
          {
            "node": "Execute Real Scene Planning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Real Scene Planning": {
      "main": [
        [
          {
            "node": "Scenes Generated?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scenes Generated?": {
      "main": [
        [
          {
            "node": "Callback: Plan Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback: Scenes Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "vf-03-v3",
  "id": "VF03ScenePlanner",
  "tags": []
}