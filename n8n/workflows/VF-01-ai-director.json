{
  "name": "VF-01 AI Director",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-01-director",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-vf01-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst headers = $input.item.json.headers || {};\nconst secret = $env.N8N_VIDEO_FACTORY_WEBHOOK_SECRET;\nconst presented = body.webhook_secret || headers['x-webhook-secret'] || headers['X-Webhook-Secret'];\nif (!secret || presented !== secret) {\n  throw new Error('Unauthorized: invalid or missing webhook secret');\n}\nif (!body.video_id) throw new Error('video_id is required');\nreturn {\n  json: {\n    video_id: body.video_id,\n    job_id: body.job_id || '',\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "id": "node-vf01-validate",
      "name": "Validate & Authenticate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/planning/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"version\": \"1.0\",\n  \"video_id\": $json.video_id,\n  \"job_id\": $json.job_id,\n  \"stage\": \"AI_DIRECTOR\"\n}) }}",
        "options": {
          "timeout": 300000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node-vf01-execute",
      "name": "Execute Real AI Director",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "director-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-vf01-outcome",
      "name": "Brief Generated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_director_\" + Date.now(),\n  \"job_id\": $('Execute Real AI Director').item.json.job_id || $('Validate & Authenticate').item.json.job_id,\n  \"event\": \"planning.brief_ready\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"SCRIPT_GENERATION\",\n  \"progress\": 35,\n  \"message\": \"اكتمل التوجيه الإبداعي الحقيقي وحُفظ الموجز\"\n}) }}",
        "onError": "continueRegularOutput"
      },
      "id": "node-vf01-ok",
      "name": "Callback: Brief Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_director_fail_\" + Date.now(),\n  \"job_id\": $('Execute Real AI Director').item.json.job_id || $('Validate & Authenticate').item.json.job_id,\n  \"event\": \"planning.failed\",\n  \"status\": \"FAILED\",\n  \"stage\": \"ERROR\",\n  \"progress\": 10,\n  \"message\": \"فشل التوجيه الإبداعي: \" + ($json.error || 'provider failure')\n}) }}",
        "onError": "continueRegularOutput"
      },
      "id": "node-vf01-fail",
      "name": "Callback: Director Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        340
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate & Authenticate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Authenticate": {
      "main": [
        [
          {
            "node": "Execute Real AI Director",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Real AI Director": {
      "main": [
        [
          {
            "node": "Brief Generated?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Brief Generated?": {
      "main": [
        [
          {
            "node": "Callback: Brief Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback: Director Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "vf-01-v3",
  "id": "VF01AiDirector",
  "tags": []
}