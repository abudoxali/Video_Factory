{
  "name": "VF-07 Voice Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-07-voice",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "id": "node-vf07-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nreturn {\n  json: {\n    job_id: body.job_id,\n    video_id: body.video_id,\n    scene_id: body.scene_id,\n    text: body.text || '',\n    targetDurationSeconds: body.targetDurationSeconds || 5,\n    model: 'eleven_multilingual_v2'\n  }\n};"
      },
      "name": "Parse Scene Voice Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 240],
      "id": "node-vf07-parse"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_voc_\" + $json.job_id + \"_\" + $json.scene_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"media.voice_generating\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"VOICE_GENERATION\",\n  \"progress\": 90,\n  \"message\": \"جاري إنشاء التعليق الصوتي للمشهد عبر ElevenLabs\"\n}"
      },
      "name": "Notify Voice Generation Start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 240],
      "id": "node-vf07-notify"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_voc_done_\" + $json.scene_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"video_id\": $json.video_id,\n  \"scene_id\": $json.scene_id,\n  \"stage\": \"VOICE_GENERATION\",\n  \"progress\": 95,\n  \"media_type\": \"VOICE\",\n  \"scene_media_state\": \"READY\",\n  \"message\": \"تم توليد وحفظ التعليق الصوتي للمشهد بنجاح في R2\"\n}"
      },
      "name": "Persist Voice Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 240],
      "id": "node-vf07-persist"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Parse Scene Voice Request", "type": "main", "index": 0 }]
      ]
    },
    "Parse Scene Voice Request": {
      "main": [
        [{ "node": "Notify Voice Generation Start", "type": "main", "index": 0 }]
      ]
    },
    "Notify Voice Generation Start": {
      "main": [
        [{ "node": "Persist Voice Ingest", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
