{
  "name": "VF-12 Distribution Coordinator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-12-distribution-coordinator",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "id": "node-vf12-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nif (!body.publication_id || !body.platform) {\n  throw new Error('publication_id and platform are required');\n}\nreturn {\n  json: {\n    publication_id: body.publication_id,\n    video_id: body.video_id,\n    platform: body.platform.toUpperCase(),\n    user_id: body.user_id,\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "name": "Parse Distribution Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 240],
      "id": "node-vf12-parse"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.platform }}",
              "value2": "YOUTUBE"
            }
          ]
        }
      },
      "name": "Route by Platform",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 240],
      "id": "node-vf12-route"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_dist_\" + $json.publication_id + \"_\" + Date.now(),\n  \"job_id\": \"job_pub_\" + $json.publication_id,\n  \"event\": \"publication.dispatched\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"PUBLISHING\",\n  \"progress\": 92,\n  \"message\": \"تم توجيه المنشور إلى محرك نشر منصة \" + $json.platform\n}"
      },
      "name": "Notify Dispatching",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 240],
      "id": "node-vf12-notify"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Parse Distribution Request", "type": "main", "index": 0 }]
      ]
    },
    "Parse Distribution Request": {
      "main": [
        [{ "node": "Route by Platform", "type": "main", "index": 0 }]
      ]
    },
    "Route by Platform": {
      "main": [
        [{ "node": "Notify Dispatching", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
