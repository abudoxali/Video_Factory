{
  "name": "VF-00 Core Job Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-job-orchestrator",
        "options": {
          "responseMode": "responseNode"
        }
      },
      "id": "node_webhook_trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "vf-job-orchestrator"
    },
    {
      "parameters": {
        "jsCode": "// Authenticate + validate the incoming job payload.\nconst body = $input.item.json.body || $input.item.json;\nconst headers = $input.item.json.headers || {};\nconst secret = process.env.N8N_VIDEO_FACTORY_WEBHOOK_SECRET;\nconst presented = body.webhook_secret || headers['x-webhook-secret'] || headers['X-Webhook-Secret'];\nif (!secret || presented !== secret) {\n  throw new Error('Unauthorized: invalid or missing webhook secret');\n}\nif (!body.job_id || !body.video_id) {\n  throw new Error('Invalid start payload: job_id and video_id are required');\n}\n\nreturn {\n  json: {\n    job_id: body.job_id,\n    video_id: body.video_id,\n    request: body.request || {},\n    version: body.version || '1.0',\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "id": "node_validate_input",
      "name": "Validate & Authenticate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 202
        },
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Job received by n8n orchestrator\",\n  \"job_id\": \"{{ $json.job_id }}\"\n}"
      },
      "id": "node_respond_to_webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_\" + $json.job_id + \"_init_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"job.progress\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"AI_DIRECTOR\",\n  \"progress\": 10,\n  \"message\": \"بدء تنفيذ التخطيط الإنتاجي الحقيقي عبر خدمة التخطيط\"\n}"
      },
      "id": "node_callback_init",
      "name": "Callback: Planning Started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/planning/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"job_id\": $json.job_id,\n  \"video_id\": $json.video_id\n}",
        "options": {
          "timeout": 600000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node_execute_planning",
      "name": "Execute Real Planning Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "planning-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node_planning_outcome",
      "name": "Planning Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1140,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_\" + $('Validate & Authenticate').item.json.job_id + \"_plan_ready_\" + Date.now(),\n  \"job_id\": $('Validate & Authenticate').item.json.job_id,\n  \"event\": \"planning.ready\",\n  \"status\": \"COMPLETED\",\n  \"stage\": \"PLAN_READY\",\n  \"progress\": 100,\n  \"message\": \"اكتمل التخطيط الإنتاجي الحقيقي — الخطة جاهزة للاعتماد والمراجعة\"\n}"
      },
      "id": "node_planning_complete",
      "name": "Callback: Plan Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_\" + $('Validate & Authenticate').item.json.job_id + \"_plan_failed_\" + Date.now(),\n  \"job_id\": $('Validate & Authenticate').item.json.job_id,\n  \"event\": \"planning.failed\",\n  \"status\": \"FAILED\",\n  \"stage\": \"ERROR\",\n  \"progress\": 10,\n  \"message\": \"فشل تنفيذ التخطيط الحقيقي: \" + ($json.error || $json.message || 'provider failure')\n}"
      },
      "id": "node_planning_failed",
      "name": "Callback: Planning Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        460
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate & Authenticate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Authenticate": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Callback: Planning Started",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback: Planning Started": {
      "main": [
        [
          {
            "node": "Execute Real Planning Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Real Planning Pipeline": {
      "main": [
        [
          {
            "node": "Planning Succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Planning Succeeded?": {
      "main": [
        [
          {
            "node": "Callback: Plan Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback: Planning Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "vf-00-v3",
  "id": "VF00CoreJobOrchestrator",
  "tags": []
}