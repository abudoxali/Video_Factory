{
  "name": "VF-09 Render Coordinator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-09-render-coordinator",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "id": "node-vf09-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nif (!body.video_id) throw new Error('video_id is required');\nreturn {\n  json: {\n    job_id: body.job_id || 'job_render_' + Date.now(),\n    video_id: body.video_id,\n    aspectRatio: body.aspectRatio || '9:16',\n    version: body.version || 1,\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "name": "Parse Render Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 240],
      "id": "node-vf09-parse"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_render_prep_\" + $json.job_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"render.preparation_started\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"RENDER_PREPARATION\",\n  \"progress\": 85,\n  \"message\": \"بدء تجهيز مخطط وتوقيتات إخراج الفيديو النهائي وتجميع المسارات\"\n}"
      },
      "name": "Notify Render Preparation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 240],
      "id": "node-vf09-notify-prep"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_rendering_\" + $json.job_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"render.rendering\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"RENDERING\",\n  \"progress\": 90,\n  \"message\": \"جاري تصيير مقاطع المشاهد وتركيب الصوت والترجمة عبر Remotion\"\n}"
      },
      "name": "Notify Rendering In Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 240],
      "id": "node-vf09-notify-rendering"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Parse Render Request", "type": "main", "index": 0 }]
      ]
    },
    "Parse Render Request": {
      "main": [
        [{ "node": "Notify Render Preparation", "type": "main", "index": 0 }]
      ]
    },
    "Notify Render Preparation": {
      "main": [
        [{ "node": "Notify Rendering In Progress", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
