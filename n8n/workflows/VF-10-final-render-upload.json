{
  "name": "VF-10 Final Render & Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-10-final-upload",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "id": "node-vf10-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nreturn {\n  json: {\n    job_id: body.job_id,\n    video_id: body.video_id,\n    render_id: body.render_id,\n    objectKey: body.objectKey,\n    sizeBytes: body.sizeBytes || 0,\n    checksum: body.checksum || ''\n  }\n};"
      },
      "name": "Parse Upload Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 240],
      "id": "node-vf10-parse"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_upload_\" + $json.job_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"render.uploading\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"FINAL_ASSEMBLY\",\n  \"progress\": 95,\n  \"message\": \"تم الانتهاء من دمج وتصيير الفيديو، وجاري رفعه وتخزينه في R2\"\n}"
      },
      "name": "Notify Final Assembly Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 240],
      "id": "node-vf10-notify"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Parse Upload Payload", "type": "main", "index": 0 }]
      ]
    },
    "Parse Upload Payload": {
      "main": [
        [{ "node": "Notify Final Assembly Upload", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
