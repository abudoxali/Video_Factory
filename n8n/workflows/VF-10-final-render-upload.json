{
  "name": "VF-10 Final Render Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-10-final-upload",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-vf10-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        240
      ],
      "webhookId": "vf-10-final-upload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst headers = $input.item.json.headers || {};\nconst secret = process.env.N8N_VIDEO_FACTORY_WEBHOOK_SECRET;\nconst presented = body.webhook_secret || headers['x-webhook-secret'] || headers['X-Webhook-Secret'];\nif (!secret || presented !== secret) {\n  throw new Error('Unauthorized: invalid or missing webhook secret');\n}\nif (!body.video_id && !body.render_id) throw new Error('video_id or render_id is required');\nreturn {\n  json: {\n    video_id: body.video_id || null,\n    job_id: body.job_id || '',\n    publication_id: body.publication_id || null,\n    render_id: body.render_id || null,\n    scene_id: body.scene_id || null,\n    platforms: body.platforms || null,\n    account_ids: body.account_ids || null,\n    metadata: body.metadata || null,\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "id": "node-vf10-validate",
      "name": "Validate & Authenticate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        240
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.VIDEO_FACTORY_BASE_URL || $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/render/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "video_id",
              "value": "={{ $json.video_id || \"\" }}"
            },
            {
              "name": "render_id",
              "value": "={{ $json.render_id || \"\" }}"
            },
            {
              "name": "verify_storage",
              "value": "=1"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node-vf10-status",
      "name": "Verify Render In Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.success === true && $json.data && $json.data.verified === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-vf10-verified",
      "name": "Upload Verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL || 'http://localhost:5678' }}/webhook/vf-11-final-qa",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_id\": $('Validate & Authenticate').item.json.video_id || '',\n  \"job_id\": $('Validate & Authenticate').item.json.job_id || '',\n  \"render_id\": $json.data.render.id,\n  \"webhook_secret\": \"{{ $env.N8N_VIDEO_FACTORY_WEBHOOK_SECRET }}\"\n}",
        "options": {
          "timeout": 15000
        },
        "onError": "continueRegularOutput"
      },
      "id": "node-vf10-trigger-qa",
      "name": "Trigger Final QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        140
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate & Authenticate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Authenticate": {
      "main": [
        [
          {
            "node": "Verify Render In Storage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Render In Storage": {
      "main": [
        [
          {
            "node": "Upload Verified?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Verified?": {
      "main": [
        [
          {
            "node": "Trigger Final QA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "vf-10-v3",
  "id": "VF10FinalRenderUpload",
  "tags": []
}
