{
  "name": "VF-06 Video Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vf-06-video",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "id": "node-vf06-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nreturn {\n  json: {\n    job_id: body.job_id,\n    video_id: body.video_id,\n    scene_id: body.scene_id,\n    prompt: body.prompt || '',\n    durationSeconds: body.durationSeconds || 5,\n    aspectRatio: body.aspectRatio || '9:16',\n    model: 'gemini-omni-flash'\n  }\n};"
      },
      "name": "Parse Scene Video Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 240],
      "id": "node-vf06-parse"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_vid_\" + $json.job_id + \"_\" + $json.scene_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"event\": \"media.video_generating\",\n  \"status\": \"PROCESSING\",\n  \"stage\": \"VIDEO_GENERATION\",\n  \"progress\": 80,\n  \"message\": \"جاري إنشاء وتوليد مشهد الفيديو عبر Google Video\"\n}"
      },
      "name": "Notify Video Generation Start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 240],
      "id": "node-vf06-notify"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_FACTORY_API_URL || 'http://localhost:3000' }}/api/internal/n8n/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-callback-secret",
              "value": "={{ $env.VIDEO_FACTORY_N8N_CALLBACK_SECRET || 'your_callback_shared_secret_here' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"1.0\",\n  \"event_id\": \"evt_vid_done_\" + $json.scene_id + \"_\" + Date.now(),\n  \"job_id\": $json.job_id,\n  \"video_id\": $json.video_id,\n  \"scene_id\": $json.scene_id,\n  \"stage\": \"VIDEO_GENERATION\",\n  \"progress\": 85,\n  \"media_type\": \"VIDEO\",\n  \"scene_media_state\": \"READY\",\n  \"message\": \"تم توليد وتخزين مقطع الفيديو للمشهد بنجاح في R2\"\n}"
      },
      "name": "Persist Video Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 240],
      "id": "node-vf06-persist"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Parse Scene Video Request", "type": "main", "index": 0 }]
      ]
    },
    "Parse Scene Video Request": {
      "main": [
        [{ "node": "Notify Video Generation Start", "type": "main", "index": 0 }]
      ]
    },
    "Notify Video Generation Start": {
      "main": [
        [{ "node": "Persist Video Ingest", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
